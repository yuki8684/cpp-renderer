# ============================================================
# 别让 git 改写二进制资源的字节。
#
# 背景：本机 core.autocrlf = true。git 靠「前 8000 字节里有没有 0x00」
# 猜文件是不是二进制。P6 的头部是纯 ASCII（"P6\n256 256\n255\n"），
# 数据段也不一定长得像二进制，于是被误判成文本
#   → checkout 时 LF 被换成 CRLF
#   → 每遇到一个 0x0A 就多插一个 0x0D
#   → 图片整体错位，读出垃圾
#
# -text 的意思是「不是文本，一个字节都别动」。
# ============================================================

*.ppm   -text
*.pnm   -text
*.pgm   -text
*.png   -text
*.jpg   -text
*.jpeg  -text
*.gif   -text
*.mp4   -text
*.webm  -text
*.bmp   -text

# 本仓库受版本控制的 .obj 只是 models/ 下的 Wavefront 模型（纯文本）。
# 注意：*.obj 也匹配 MSVC 的目标文件，所以这里只圈 models/。
models/*.obj  text eol=lf
